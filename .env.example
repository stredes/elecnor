# URL of the server-side FastAPI/BFF upstream. FASTAPI_API_URL takes precedence.
BACKEND_API_URL=
FASTAPI_API_URL=
# http is selected automatically when either URL is present.
BACKEND_API_MODE=http
BACKEND_TIMEOUT_MS=10000
FASTAPI_CONTRACT_VERSION=c-legacy-inspections/1.0.0
FASTAPI_DRIVE_CONTRACT_VERSION=c-legacy-inspections/1.0.0
FASTAPI_INTERNAL_TOKEN=
BACKEND_DRIVE_SYNC_STATE_ENABLED=false
BACKEND_DOCUMENT_DOWNLOAD_ENABLED=false
# official|all. The portal production view uses all processed FastAPI records;
# official remains available for a technical-only deployment.
BACKEND_INSPECTIONS_SCOPE=all

# Development/test only. Never enable this in production.
BACKEND_USE_SYNTHETIC_DATA=false

# Expected upstream routes. Inspections, Drive sync and inspection download
# exist in the current checkout; the remaining routes stay gated until FastAPI
# publishes their contracts. Duplicate uniqueness is resolved by the stage-2
# guard, so there is no manual candidate/decision route.
FASTAPI_EXTRACT_PATH=/api/v1/pdf/extract
FASTAPI_IMPORT_PATH=/api/v1/import
BACKEND_DASHBOARD_PATH=/api/v1/dashboard
BACKEND_INSPECTIONS_PATH=/api/v1/inspections
BACKEND_METRICS_PATH=/api/v1/metrics
BACKEND_UNKNOWNS_PATH=/api/v1/unknown-metrics
BACKEND_FINDINGS_PATH=/api/v1/findings
BACKEND_LOGS_PATH=/api/v1/logs
BACKEND_ANALYTICS_PATH=/api/v1/analytics
BACKEND_PROCEDURES_PATH=/api/v1/procedures
BACKEND_TECHNICIANS_PATH=/api/v1/technicians
BACKEND_EXCEL_PATH=/api/v1/export/excel
BACKEND_DRIVE_SYNC_PATH=/api/v1/sync/drive
BACKEND_DRIVE_SYNC_STATUS_PATH=/api/v1/sync/drive/{id}
BACKEND_DRIVE_SYNC_RETRY_PATH=/api/v1/sync/drive/{id}/retry
BACKEND_INSPECTION_DOWNLOAD_PATH=/api/v1/inspections/{id}/download
BACKEND_DOCUMENT_DOWNLOAD_PATH=/api/v1/documents/{id}/download
