{
  "name": "elecnor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format:check": "eslint . --max-warnings=0 && npm run quality:check",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/contracts tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "quality:lines": "node scripts/quality/check-lines.mjs",
    "quality:boundaries": "node scripts/quality/check-boundaries.mjs",
    "quality:contracts": "node scripts/quality/check-contracts.mjs",
    "quality:check": "npm run quality:lines && npm run quality:boundaries && npm run quality:contracts",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@hc-soluciones/engineering-brain": "file:vendor/hc-soluciones-engineering-brain-5.0.1.tgz",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^26.1.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
